# ===================================
# 高槻バスシステム - 環境変数設定テンプレート
# ===================================
# このファイルを .env にコピーして使用してください
# 本番環境では必ず値を変更してください

# 環境設定
ENVIRONMENT=development
SKIP_MIGRATION=false

# データベース設定
POSTGRES_HOST=postgres
POSTGRES_DB=mydb
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_PORT=5432

# Redis設定
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# セキュリティトークン（本番環境では必ず変更！）
ADMIN_SERVICE_TOKEN=CHANGE_ME_IN_PRODUCTION
API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# リクエストタイムアウト（秒）
REQUEST_TIMEOUT=10

# Cookie設定
COOKIE_DOMAIN=localhost

# ログレベル
LOG_LEVEL=INFO

# Flask設定
FLASK_ENV=development
FLASK_DEBUG=false

# セッション設定
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
