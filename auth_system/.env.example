# ===================================
# 高槻バスauthシステム - 環境変数設定テンプレート
# ===================================
# このファイルを .env にコピーして使用してください
# 本番環境では必ず値を変更してください

# バス号車番号（認証端末ごとに設定）
# 例: 1, 2, 3, 4
ID=1

# 学生向けAPI（studentサービス）のベースURL
# 本番環境では https を推奨
STUDENT_API_URL=https://shuttlebus.kutc.kansai-u.ac.jp


# =========================
# Flask secret (本番では必ず変更)
# =========================
# auth.py 内では直書きされているが、
# 将来的な.env化を想定して記載
FLASK_SECRET_KEY=changeme